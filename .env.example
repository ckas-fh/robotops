# Copy to .env (never commit .env) and export before running, e.g.:
#   set -a; source .env; set +a

# --- REST API --------------------------------------------------------------------
# Leave unset to run the API embedded inside Streamlit on a random localhost port.
# Set it to use a separately started API:  uvicorn api.main:app --port 8000
# ROBOTOPS_API_URL=http://127.0.0.1:8000

# Optional shared secret: when set, every /api/v1 request must send X-API-Key.
# Set the same value for both the API and Streamlit processes.
# ROBOTOPS_API_KEY=change-me

# --- Data ---------------------------------------------------------------------------
# ROBOTOPS_MODE=demo            # demo = isolated per visitor (default); shared = one DB
# ROBOTOPS_DATA_DIR=.data

# --- GitHub Issues (optional) -------------------------------------------------------------
# Dry run is ON unless set to false AND a token + repo are configured AND ROBOTOPS_MODE=shared
# (live mode is refused in the public per-visitor demo, where anyone could approve).
# Use a fine-grained token limited to ONE repository with "Issues: Read and write" only.
# The token is read only by the API process and is never sent to the browser.
# GITHUB_TOKEN=github_pat_xxx
# ROBOTOPS_GITHUB_REPO=your-user/robotops-sandbox
# ROBOTOPS_GITHUB_DRY_RUN=true
